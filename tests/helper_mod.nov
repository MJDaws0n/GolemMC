module helper_mod;

// --- test issue 1: overloaded functions across modules ---
fn overload_test(n: i32) -> str {
    return "i32";
}

fn overload_test(n: i64) -> str {
    return "i64";
}

// --- test issue 14: register name collision in imported module ---
fn register_name_test() -> i32 {
    let x1: i32 = 10;
    let x2: i32 = 20;
    let result: i32 = x1 + x2;
    return result;
}

// --- test issue 15: 6th+ parameter ---
fn six_params(a: i32, b: i32, c: i32, d: i32, e: i32, f: i32) -> i32 {
    return a + b + c + d + e + f;
}

fn seven_params(a: i32, b: i32, c: i32, d: i32, e: i32, f: i32, g: i32) -> i32 {
    return a + b + c + d + e + f + g;
}
