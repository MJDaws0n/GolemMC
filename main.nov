module GolemMC;

import lib/std;
import src/settings;
import src/server;

fn main(argc: i32, argv: u64) -> i32 {
    let path: str = "server.properties";
    if (argc == 2) { path = argv_get(argv, 1); }
    if (argc > 2) { print("Usage: GolemMC [server.properties]"); return 2; }
    let options: Settings = new Settings(path);
    if (options.error != "") { print(options.error); return 1; }
    let instance: Server = new Server(options);
    if (instance.error != "") { print(instance.error); return 1; }
    return instance.run();
}
