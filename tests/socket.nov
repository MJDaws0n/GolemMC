module socket_tests;

import ../lib/std;
import ../lib/socket;
import ../lib/darwin;
import ../src/identity;
import ../lib/digest;

fn main() -> i32 {
    let uuid: str = offline_uuid("GolemReference");
    if (hex_digest(uuid, 16) != "15795b45a0eb31f0bf373d456b027750") { return 1; }
    if (hash_seed(5241482691752223138) != 2668435394204562907) { return 2; }
    if (monotonic_ms() <= 0) { return 3; }
    let socket: i32 = socket_listener("127.0.0.1", 0);
    if (socket < 0) { return 4; }
    let poller: PollSet = new PollSet(1);
    poller.add(socket, 1);
    if (poller.wait(1) != 0) { return 5; }
    socket_close(socket);
    let invalid: i32 = socket_listener("not-an-address", 0);
    if (invalid != -1) { return 6; }
    if (!digest_vectors()) { return 7; }
    return 0;
}

fn digest_vectors() -> bool {
    if (hex_digest(digest_md5("", 0), 16) != "d41d8cd98f00b204e9800998ecf8427e") { return false; }
    if (hex_digest(digest_sha256("", 0), 32) != "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855") { return false; }
    if (hex_digest(digest_md5("abc", 3), 16) != "900150983cd24fb0d6963f7d28e17f72") { return false; }
    if (hex_digest(digest_sha256("abc", 3), 32) != "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad") { return false; }
    if (hex_digest(digest_md5("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789", 62), 16) != "d174ab98d277d9f5a5611c2c9f419d9f") { return false; }
    if (hex_digest(digest_sha256("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789", 62), 32) != "db4bfcbd4da0cd85a60c3c37d3fbd8805c77f15fc6b1fdfe614ee0a7c8fdb4c0") { return false; }
    return true;
}

fn hex_digest(value: str, length: i32) -> str {
    let digits: str = "0123456789abcdef";
    let hex: StringBuilder = new StringBuilder();
    for (let index: i32 = 0; index < length; index++) {
        let octet: i32 = byte_at(value, index);
        hex.append_byte(byte_at(digits, octet >> 4));
        hex.append_byte(byte_at(digits, octet & 15));
    }
    return hex.text();
}
