// ---------------------------------------------------------------------------
// terrain.nov - terrain generation that actually slaps
//
// complete rewrite using i64 fixed-point math for way better precision
// than the old 8-bit fixed-point system. now uses 16 fractional bits
// (65536 = 1.0) which gives us enough precision for proper noise
//
// features:
//   - improved perlin noise with proper gradient vectors
//   - multi-octave noise for continental, erosion, and detail layers
//   - spline-based height mapping inspired by vanilla MC
//   - proper surface rules (grass, dirt, sand, gravel, etc)
//   - cave generation using 3D noise
//   - ore distribution at correct depths
//   - tree placement with proper spacing
//   - deepslate below y=0 like modern minecraft
//
// uses i64 everywhere cos novus i32 doesnt wrap at 32 bits (issue #13)
// and we need the extra range for fixed-point multiplication anyway
// ---------------------------------------------------------------------------

module terrain;

import ../game/blocks;

// ---------------------------------------------------------------------------
// fixed-point constants
// 16 fractional bits: 65536 = 1.0, 32768 = 0.5
// using i64 for all math to avoid overflow on multiply
// ---------------------------------------------------------------------------

fn FP_BITS() -> i64 { return 16; }
fn FP_ONE() -> i64 { return 65536; }
fn FP_HALF() -> i64 { return 32768; }

// ---------------------------------------------------------------------------
// i64 fixed-point helpers
// ---------------------------------------------------------------------------

fn fp_mul(a: i64, b: i64) -> i64 {
    return (a * b) >> 16;
}

fn fp_div(a: i64, b: i64) -> i64 {
    if (b == 0) { return 0; }
    return (a << 16) / b;
}

fn fp_from_i32(v: i32) -> i64 {
    let v64: i64 = v;
    return v64 << 16;
}

fn fp_to_i32(v: i64) -> i32 {
    let r: i64 = v >> 16;
    let ri: i32 = r;
    return ri;
}

fn fp_abs(v: i64) -> i64 {
    if (v < 0) { return 0 - v; }
    return v;
}

fn fp_min(a: i64, b: i64) -> i64 {
    if (a < b) { return a; }
    return b;
}

fn fp_max(a: i64, b: i64) -> i64 {
    if (a > b) { return a; }
    return b;
}

fn fp_clamp(v: i64, lo: i64, hi: i64) -> i64 {
    if (v < lo) { return lo; }
    if (v > hi) { return hi; }
    return v;
}

// linear interpolation: a + (b - a) * t where t is fixed-point [0, FP_ONE]
fn fp_lerp(a: i64, b: i64, t: i64) -> i64 {
    return a + fp_mul(b - a, t);
}

// floor to integer (handles negative correctly)
fn fp_floor(v: i64) -> i64 {
    if (v >= 0) { return (v >> 16) << 16; }
    // for negative values, shift right then shift left
    // -0.5 (=-32768) >> 16 = -1, << 16 = -65536 = floor(-0.5) = -1.0 ✓
    return (v >> 16) << 16;
}

// fractional part (always positive, 0 to FP_ONE-1)
fn fp_frac(v: i64) -> i64 {
    let f: i64 = v - fp_floor(v);
    if (f < 0) { f = f + 65536; }
    return f;
}

// ---------------------------------------------------------------------------
// smoothstep: 6t^5 - 15t^4 + 10t^3 (improved perlin fade curve)
// t is in fixed-point [0, FP_ONE]
// ---------------------------------------------------------------------------

fn fp_fade(t: i64) -> i64 {
    // 6t^5 - 15t^4 + 10t^3
    let t2: i64 = fp_mul(t, t);
    let t3: i64 = fp_mul(t2, t);
    let t4: i64 = fp_mul(t3, t);
    let t5: i64 = fp_mul(t4, t);

    // 6 * t5 - 15 * t4 + 10 * t3
    // in fixed-point: multiply by integer, keep fractional
    return 6 * t5 - 15 * t4 + 10 * t3;
}

// ---------------------------------------------------------------------------
// hash function using xorshift for deterministic pseudo-random numbers
// takes a seed and coordinates, returns a pseudo-random i64
//
// this replaces the old terrain_hash with a much better distribution
// no trunc32 needed cos we're using i64 throughout
// ---------------------------------------------------------------------------

fn hash_2d(hx: i64, hz: i64, seed: i64) -> i64 {
    // murmurhash-inspired mixing
    let h: i64 = seed;
    h = h + hx * 6364136223846793005;
    h = h ^ (h >> 33);
    h = h * 1442695040888963407;
    h = h + hz * 2862933555777941757;
    h = h ^ (h >> 33);
    h = h * 3202034522624059733;
    h = h ^ (h >> 33);
    return h;
}

fn hash_3d(hx: i64, hy: i64, hz: i64, seed: i64) -> i64 {
    let h: i64 = seed;
    h = h + hx * 6364136223846793005;
    h = h + hy * 1442695040888963407;
    h = h ^ (h >> 33);
    h = h * 2862933555777941757;
    h = h + hz * 3202034522624059733;
    h = h ^ (h >> 33);
    h = h * 6364136223846793005;
    h = h ^ (h >> 33);
    return h;
}

// make hash positive
fn hash_pos(h: i64) -> i64 {
    if (h < 0) { return 0 - h; }
    return h;
}

// ---------------------------------------------------------------------------
// gradient function for 2D improved perlin noise
// 8 gradient directions for better isotropy than 4
// returns dot product of gradient with distance vector (fixed-point)
// ---------------------------------------------------------------------------

fn grad2d(hash: i64, dx: i64, dz: i64) -> i64 {
    let h: i64 = hash & 7;
    if (h == 0) { return dx + dz; }
    if (h == 1) { return 0 - dx + dz; }
    if (h == 2) { return dx - dz; }
    if (h == 3) { return 0 - dx - dz; }
    if (h == 4) { return dx; }
    if (h == 5) { return 0 - dx; }
    if (h == 6) { return dz; }
    return 0 - dz;
}

// ---------------------------------------------------------------------------
// gradient for 3D noise (12 gradient directions like classic perlin)
// ---------------------------------------------------------------------------

fn grad3d(hash: i64, dx: i64, dy: i64, dz: i64) -> i64 {
    let h: i64 = hash & 15;
    if (h == 0) { return dx + dy; }
    if (h == 1) { return 0 - dx + dy; }
    if (h == 2) { return dx - dy; }
    if (h == 3) { return 0 - dx - dy; }
    if (h == 4) { return dx + dz; }
    if (h == 5) { return 0 - dx + dz; }
    if (h == 6) { return dx - dz; }
    if (h == 7) { return 0 - dx - dz; }
    if (h == 8) { return dy + dz; }
    if (h == 9) { return 0 - dy + dz; }
    if (h == 10) { return dy - dz; }
    if (h == 11) { return 0 - dy - dz; }
    if (h == 12) { return dx + dy; }
    if (h == 13) { return 0 - dx + dy; }
    if (h == 14) { return dx - dz; }
    return 0 - dx - dz;
}

// ---------------------------------------------------------------------------
// 2D improved perlin noise
// coords are world-space integers, scale controls frequency
// returns fixed-point value roughly in [-FP_ONE, FP_ONE]
// ---------------------------------------------------------------------------

fn perlin2d(wx: i64, wz: i64, scale: i64, seed: i64) -> i64 {
    // convert to noise space (fixed-point) using scale
    // scale = how many blocks per noise cell (e.g. 256 = smooth, 16 = noisy)
    let nx: i64 = fp_div(wx << 16, scale << 16);
    let nz: i64 = fp_div(wz << 16, scale << 16);

    // grid cell coordinates
    let gx: i64 = nx >> 16;
    let gz: i64 = nz >> 16;
    if (nx < 0 && (nx & 65535) != 0) { gx = gx - 1; }
    if (nz < 0 && (nz & 65535) != 0) { gz = gz - 1; }

    // fractional position within cell [0, FP_ONE)
    let fx: i64 = nx - (gx << 16);
    let fz: i64 = nz - (gz << 16);

    // smoothstep interpolation weights
    let u: i64 = fp_fade(fx);
    let v: i64 = fp_fade(fz);

    // hash the four corners
    let h00: i64 = hash_2d(gx, gz, seed);
    let h10: i64 = hash_2d(gx + 1, gz, seed);
    let h01: i64 = hash_2d(gx, gz + 1, seed);
    let h11: i64 = hash_2d(gx + 1, gz + 1, seed);

    // gradient dot products
    let g00: i64 = grad2d(h00, fx, fz);
    let g10: i64 = grad2d(h10, fx - 65536, fz);
    let g01: i64 = grad2d(h01, fx, fz - 65536);
    let g11: i64 = grad2d(h11, fx - 65536, fz - 65536);

    // bilinear interpolation
    let n0: i64 = fp_lerp(g00, g10, u);
    let n1: i64 = fp_lerp(g01, g11, u);
    return fp_lerp(n0, n1, v);
}

// ---------------------------------------------------------------------------
// 3D improved perlin noise for caves
// ---------------------------------------------------------------------------

fn perlin3d(wx: i64, wy: i64, wz: i64, scale: i64, seed: i64) -> i64 {
    let nx: i64 = fp_div(wx << 16, scale << 16);
    let ny: i64 = fp_div(wy << 16, scale << 16);
    let nz: i64 = fp_div(wz << 16, scale << 16);

    let gx: i64 = nx >> 16;
    let gy: i64 = ny >> 16;
    let gz: i64 = nz >> 16;
    if (nx < 0 && (nx & 65535) != 0) { gx = gx - 1; }
    if (ny < 0 && (ny & 65535) != 0) { gy = gy - 1; }
    if (nz < 0 && (nz & 65535) != 0) { gz = gz - 1; }

    let fx: i64 = nx - (gx << 16);
    let fy: i64 = ny - (gy << 16);
    let fz: i64 = nz - (gz << 16);

    let u: i64 = fp_fade(fx);
    let v: i64 = fp_fade(fy);
    let w: i64 = fp_fade(fz);

    let h000: i64 = hash_3d(gx, gy, gz, seed);
    let h100: i64 = hash_3d(gx + 1, gy, gz, seed);
    let h010: i64 = hash_3d(gx, gy + 1, gz, seed);
    let h110: i64 = hash_3d(gx + 1, gy + 1, gz, seed);
    let h001: i64 = hash_3d(gx, gy, gz + 1, seed);
    let h101: i64 = hash_3d(gx + 1, gy, gz + 1, seed);
    let h011: i64 = hash_3d(gx, gy + 1, gz + 1, seed);
    let h111: i64 = hash_3d(gx + 1, gy + 1, gz + 1, seed);

    let g000: i64 = grad3d(h000, fx, fy, fz);
    let g100: i64 = grad3d(h100, fx - 65536, fy, fz);
    let g010: i64 = grad3d(h010, fx, fy - 65536, fz);
    let g110: i64 = grad3d(h110, fx - 65536, fy - 65536, fz);
    let g001: i64 = grad3d(h001, fx, fy, fz - 65536);
    let g101: i64 = grad3d(h101, fx - 65536, fy, fz - 65536);
    let g011: i64 = grad3d(h011, fx, fy - 65536, fz - 65536);
    let g111: i64 = grad3d(h111, fx - 65536, fy - 65536, fz - 65536);

    let n00: i64 = fp_lerp(g000, g100, u);
    let n10: i64 = fp_lerp(g010, g110, u);
    let n01: i64 = fp_lerp(g001, g101, u);
    let n11: i64 = fp_lerp(g011, g111, u);

    let nn0: i64 = fp_lerp(n00, n10, v);
    let nn1: i64 = fp_lerp(n01, n11, v);

    return fp_lerp(nn0, nn1, w);
}

// ---------------------------------------------------------------------------
// octave noise - stack multiple perlin samples at different frequencies
// each octave doubles frequency and halves amplitude
// gives that classic natural terrain look with big shapes + fine detail
// ---------------------------------------------------------------------------

fn octave2d(wx: i32, wz: i32, base_scale: i32, octaves: i32, seed: i32) -> i64 {
    let total: i64 = 0;
    let amplitude: i64 = 65536;  // starts at 1.0
    let max_amp: i64 = 0;
    let scale: i64 = base_scale;
    let sd: i64 = seed;
    let wxi: i64 = wx;
    let wzi: i64 = wz;

    let oc: i32 = 0;
    while (oc < octaves) {
        let n: i64 = perlin2d(wxi, wzi, scale, sd);
        total = total + fp_mul(n, amplitude);
        max_amp = max_amp + amplitude;
        amplitude = amplitude >> 1;
        scale = scale >> 1;
        if (scale < 4) { scale = 4; }
        sd = sd + 31337;
        oc = oc + 1;
    }

    // normalize to roughly [-FP_ONE, FP_ONE]
    if (max_amp > 0) {
        total = fp_div(total, max_amp);
    }
    return total;
}

fn octave3d(wx: i32, wy: i32, wz: i32, base_scale: i32, octaves: i32, seed: i32) -> i64 {
    let total: i64 = 0;
    let amplitude: i64 = 65536;
    let max_amp: i64 = 0;
    let scale: i64 = base_scale;
    let sd: i64 = seed;
    let wxi: i64 = wx;
    let wyi: i64 = wy;
    let wzi: i64 = wz;

    let oc: i32 = 0;
    while (oc < octaves) {
        let n: i64 = perlin3d(wxi, wyi, wzi, scale, sd);
        total = total + fp_mul(n, amplitude);
        max_amp = max_amp + amplitude;
        amplitude = amplitude >> 1;
        scale = scale >> 1;
        if (scale < 4) { scale = 4; }
        sd = sd + 31337;
        oc = oc + 1;
    }

    if (max_amp > 0) {
        total = fp_div(total, max_amp);
    }
    return total;
}

// ---------------------------------------------------------------------------
// terrain height calculation
//
// uses three noise layers inspired by vanilla MC:
//   - continentalness: huge features, ocean vs land (scale 512)
//   - erosion: medium features, flat vs hilly (scale 256)
//   - peaks: detail layer, individual hills and valleys (scale 64)
//
// these get combined through a simplified spline system that maps
// noise values to height offsets. not identical to vanilla but produces
// similar-looking terrain with mountains, plains, oceans, and beaches
// ---------------------------------------------------------------------------

// simplified spline evaluation - maps an input value to output
// using linear segments. mimics vanilla MC's approach but simpler
fn spline_height(continental: i64, erosion: i64, peaks: i64) -> i32 {
    // continental determines base height:
    //   -1.0 to -0.5 = deep ocean (y ~= 30-40)
    //   -0.5 to -0.2 = ocean (y ~= 40-55)
    //   -0.2 to  0.0 = coast/beach (y ~= 58-63)
    //    0.0 to  0.3 = plains (y ~= 63-70)
    //    0.3 to  0.7 = hills (y ~= 70-100)
    //    0.7 to  1.0 = mountains (y ~= 100-180)

    let base: i64 = 0;

    // deep ocean
    if (continental < 0 - 32768) {
        // map [-FP_ONE, -0.5] to [30, 40]
        let t: i64 = continental + 65536;  // shift to [0, 0.5]
        base = fp_from_i32(30) + fp_mul(t, fp_from_i32(20));
    }
    // ocean
    else if (continental < 0 - 13107) {
        // map [-0.5, -0.2] to [40, 55]
        let t: i64 = fp_div(continental + 32768, 19661);  // normalize to [0,1]
        base = fp_from_i32(40) + fp_mul(t, fp_from_i32(15));
    }
    // coast/beach
    else if (continental < 0) {
        // map [-0.2, 0] to [55, 63]
        let t: i64 = fp_div(continental + 13107, 13107);
        base = fp_from_i32(55) + fp_mul(t, fp_from_i32(8));
    }
    // plains
    else if (continental < 19661) {
        // map [0, 0.3] to [63, 70]
        let t: i64 = fp_div(continental, 19661);
        base = fp_from_i32(63) + fp_mul(t, fp_from_i32(7));
    }
    // hills
    else if (continental < 45875) {
        // map [0.3, 0.7] to [70, 100]
        let t: i64 = fp_div(continental - 19661, 26214);
        base = fp_from_i32(70) + fp_mul(t, fp_from_i32(30));
    }
    // mountains
    else {
        // map [0.7, 1.0] to [100, 180]
        let t: i64 = fp_div(continental - 45875, 19661);
        if (t > 65536) { t = 65536; }
        base = fp_from_i32(100) + fp_mul(t, fp_from_i32(80));
    }

    // erosion flattens terrain in plains, amplifies in mountains
    // high erosion = flatter, low erosion = more extreme
    let erosion_factor: i64 = 65536 - fp_abs(erosion);  // [0, FP_ONE]
    erosion_factor = fp_mul(erosion_factor, erosion_factor >> 1);  // non-linear

    // peaks add detail proportional to the terrain type
    let peak_amplitude: i64 = 0;
    if (continental > 19661) {
        // hills and mountains get bigger peak detail
        peak_amplitude = fp_mul(continental - 19661, fp_from_i32(15));
    } else if (continental > 0) {
        // plains get small bumps
        peak_amplitude = fp_from_i32(3);
    } else {
        // ocean floor gets gentle variations
        peak_amplitude = fp_from_i32(2);
    }

    let height_fp: i64 = base + fp_mul(peaks, peak_amplitude);

    // erosion modifies: positive erosion flattens toward sea level
    if (erosion > 0) {
        let flatten: i64 = fp_mul(erosion, fp_from_i32(8));
        if (height_fp > fp_from_i32(63)) {
            let above: i64 = height_fp - fp_from_i32(63);
            height_fp = height_fp - fp_mul(above >> 2, erosion);
        }
    }

    let height: i32 = fp_to_i32(height_fp);

    // clamp to valid range
    if (height < -60) { height = -60; }
    if (height > 250) { height = 250; }

    return height;
}

// main height function - returns surface y at world (x, z)
fn terrain_height(wx: i32, wz: i32, seed: i32) -> i32 {
    let sd: i64 = seed;

    // continentalness - huge scale, determines ocean vs land
    // 3 octaves is enough for large-scale features (faster than 5)
    let continental: i64 = octave2d(wx, wz, 512, 3, seed);

    // erosion - medium scale, flat vs hilly areas
    let erosion: i64 = octave2d(wx, wz, 256, 2, seed + 99999);

    // peaks - detail scale, individual bumps and valleys
    let peaks: i64 = octave2d(wx, wz, 64, 2, seed + 77777);

    return spline_height(continental, erosion, peaks);
}

// ---------------------------------------------------------------------------
// block type at a given world position
//
// uses the terrain height + depth to determine which block goes where:
//   - bedrock: y=-64 (always) + random patches from y=-63 to -60
//   - deepslate: y=-64 to y=0
//   - stone: y=0 to surface-4
//   - dirt: surface-3 to surface-1
//   - grass: at surface (or sand near water)
//   - water: fills below sea level
//   - air: above surface
//   - caves carved through stone/deepslate
//   - ores distributed at appropriate depths
// ---------------------------------------------------------------------------

// version that takes pre-computed surface height to skip redundant noise calcs
fn terrain_block_at_h(wx: i32, wy: i32, wz: i32, seed: i32, surface: i32) -> i32 {
    // bedrock (y=-64 is guaranteed, then random up to y=-61)
    if (wy == -64) { return BLK_BEDROCK(); }
    if (wy < -60) {
        let bh: i64 = hash_3d(wx, wy, wz, seed + 7);
        if ((hash_pos(bh) & 3) == 0) { return BLK_BEDROCK(); }
    }

    // above surface
    if (wy > surface) {
        if (wy <= SEA_LEVEL()) {
            return BLK_WATER();
        }
        return BLK_AIR();
    }

    // cave generation using hash-based approach (much faster than 3D noise)
    // cheese caves: large chambers using hash with spatial locality
    if (wy > -58 && wy < surface - 2) {
        let ch: i64 = hash_3d(wx >> 3, wy >> 3, wz >> 3, seed + 111111);
        let cv: i64 = hash_pos(ch);
        // ~5% of 8x8x8 regions are cave chambers
        if ((cv & 31) < 2) {
            // within a cave region, carve based on fine-grained hash
            let fh: i64 = hash_3d(wx, wy, wz, seed + 222222);
            let fv: i64 = hash_pos(fh);
            // ~70% of blocks in a cave region are carved
            if ((fv & 7) < 5) {
                if (wy <= -55) { return BLK_LAVA(); }
                return BLK_AIR();
            }
        }
        // spaghetti tunnels: thin passages using hash
        let th1: i64 = hash_3d(wx >> 1, wy >> 1, wz >> 1, seed + 333333);
        let tv1: i64 = hash_pos(th1);
        // ~1% chance of being in a tunnel path
        if ((tv1 & 127) < 2) {
            if (wy <= -55) { return BLK_LAVA(); }
            return BLK_AIR();
        }
    }

    // at surface
    if (wy == surface) {
        // underwater surface
        if (surface < SEA_LEVEL() - 2) {
            let sh: i64 = hash_2d(wx, wz, seed + 55555);
            if ((hash_pos(sh) & 3) == 0) { return BLK_GRAVEL(); }
            return BLK_SAND();
        }
        // beach zone
        if (surface <= SEA_LEVEL() + 1) {
            return BLK_SAND();
        }
        // high altitude = stone surface
        if (surface > 120) {
            return BLK_STONE();
        }
        // normal = grass
        return BLK_GRASS_BLOCK();
    }

    // dirt/sand layer (3 blocks below surface)
    if (wy > surface - 4) {
        if (surface < SEA_LEVEL()) {
            return BLK_SAND();
        }
        if (surface <= SEA_LEVEL() + 1) {
            return BLK_SANDSTONE();
        }
        return BLK_DIRT();
    }

    // ore generation using 3D hash
    let ore_h: i64 = hash_3d(wx, wy, wz, seed + 444444);
    let ore_v: i64 = hash_pos(ore_h);

    // deepslate zone (below y=0)
    if (wy < 0) {
        // deepslate ores
        if (wy < -16 && (ore_v & 1023) < 1) { return BLK_DEEPSLATE_DIAMOND_ORE(); }
        if (wy < 0 && (ore_v & 511) < 2) { return BLK_DEEPSLATE_GOLD_ORE(); }
        if ((ore_v & 255) < 3) { return BLK_DEEPSLATE_IRON_ORE(); }
        if ((ore_v & 255) < 6) { return BLK_DEEPSLATE_COAL_ORE(); }
        if ((ore_v & 511) < 2) { return BLK_DEEPSLATE_COPPER_ORE(); }
        if ((ore_v & 511) < 3) { return BLK_DEEPSLATE_LAPIS_ORE(); }
        if ((ore_v & 511) < 4) { return BLK_DEEPSLATE_REDSTONE_ORE(); }
        if (wy < -32 && (ore_v & 1023) < 1) { return BLK_DEEPSLATE_EMERALD_ORE(); }

        // stone variant patches in deepslate zone
        let dv: i64 = hash_3d(wx, wy, wz, seed + 555555);
        let dvp: i64 = hash_pos(dv);
        if ((dvp & 31) < 2) { return BLK_TUFF(); }

        return BLK_DEEPSLATE();
    }

    // stone zone (y=0 and above)
    // ores at various depths
    if (wy < 16 && (ore_v & 1023) < 1) { return BLK_DIAMOND_ORE(); }
    if (wy < 32 && (ore_v & 511) < 2) { return BLK_GOLD_ORE(); }
    if (wy < 64 && (ore_v & 127) < 3) { return BLK_IRON_ORE(); }
    if (wy < 96 && (ore_v & 127) < 4) { return BLK_COAL_ORE(); }
    if (wy < 48 && (ore_v & 511) < 2) { return BLK_COPPER_ORE(); }
    if (wy < 32 && (ore_v & 511) < 1) { return BLK_LAPIS_ORE(); }
    if (wy < 16 && (ore_v & 511) < 2) { return BLK_REDSTONE_ORE(); }

    // stone variant patches
    let sv: i64 = hash_3d(wx, wy, wz, seed + 666666);
    let svp: i64 = hash_pos(sv);
    if ((svp & 63) < 3) { return BLK_GRANITE(); }
    if ((svp & 63) >= 3 && (svp & 63) < 6) { return BLK_DIORITE(); }
    if ((svp & 63) >= 6 && (svp & 63) < 9) { return BLK_ANDESITE(); }

    return BLK_STONE();
}

fn terrain_block_at(wx: i32, wy: i32, wz: i32, seed: i32) -> i32 {
    let surface: i32 = terrain_height(wx, wz, seed);
    return terrain_block_at_h(wx, wy, wz, seed, surface);
}

// ---------------------------------------------------------------------------
// tree placement - determines if a tree should spawn at (x, z)
// returns tree height (4-7) or 0 for no tree
// ---------------------------------------------------------------------------

// version with pre-computed surface height for the tree position
fn tree_at_h(wx: i32, wz: i32, seed: i32, surface: i32) -> i32 {
    // trees only on grass (above sea level, below snow line)
    if (surface <= SEA_LEVEL() + 1) { return 0; }
    if (surface > 120) { return 0; }

    // density check - roughly 1 in 80 surface blocks
    let th: i64 = hash_2d(wx, wz, seed + 777777);
    let thp: i64 = hash_pos(th);
    if ((thp % 80) != 0) { return 0; }

    // flat ground check using hash instead of expensive neighbor heights
    // this is cheaper and gives similar results for tree placement
    let flat_h: i64 = hash_2d(wx + 17, wz + 31, seed + 888000);
    let flat_v: i64 = hash_pos(flat_h);
    if ((flat_v % 5) == 0) { return 0; }

    // tree height 4-7 blocks
    let height_var: i64 = hash_pos(th >> 7);
    let th_i32: i32 = height_var & 3;
    return 4 + th_i32;
}

fn tree_at(wx: i32, wz: i32, seed: i32) -> i32 {
    let surface: i32 = terrain_height(wx, wz, seed);
    return tree_at_h(wx, wz, seed, surface);
}

// ---------------------------------------------------------------------------
// get block at position including trees and vegetation
// trees = oak log trunk + oak leaves canopy
// also places short grass and flowers on suitable terrain
// ---------------------------------------------------------------------------

// version with pre-computed surface height for the current position
// uses hash-based height estimates for tree neighbor checks to avoid
// expensive terrain_height calls (24 per block × 12 octaves each = way too slow)
fn terrain_block_with_trees_h(wx: i32, wy: i32, wz: i32, seed: i32, surface: i32) -> i32 {
    // quick bail: if we're more than 15 blocks from surface, no trees possible
    if (wy > surface + 15 || wy < surface - 2) {
        // vegetation still possible at surface+1
        if (wy == surface + 1 && surface > SEA_LEVEL() + 1 && surface < 120) {
            let base_block: i32 = terrain_block_at_h(wx, wy - 1, wz, seed, surface);
            if (base_block == BLK_GRASS_BLOCK()) {
                let veg_h: i64 = hash_2d(wx, wz, seed + 999999);
                let vegp: i64 = hash_pos(veg_h);
                if ((vegp % 7) == 0) { return BLK_SHORT_GRASS(); }
                if ((vegp % 50) == 1) { return BLK_DANDELION(); }
                if ((vegp % 50) == 2) { return BLK_POPPY(); }
            }
        }
        return terrain_block_at_h(wx, wy, wz, seed, surface);
    }

    // check for trees in a 2-block radius (leaves extend 2 blocks from trunk)
    let tx: i32 = wx - 2;
    while (tx <= wx + 2) {
        let tz: i32 = wz - 2;
        while (tz <= wz + 2) {
            // use the passed-in height for current column,
            // estimate height for neighbors using the same height + small hash offset
            // this avoids 24 expensive terrain_height calls per block
            let ts: i32 = surface;
            if (tx != wx || tz != wz) {
                // estimate neighbor height: surface + small hash-based variation
                let nh: i64 = hash_2d(tx, tz, seed + 654321);
                let nv: i64 = hash_pos(nh);
                let diff: i32 = (nv & 7) - 4;  // -4 to +3
                ts = surface + diff;
            }
            let th: i32 = tree_at_h(tx, tz, seed, ts);
            if (th > 0) {
                let trunk_base: i32 = ts + 1;
                let trunk_top: i32 = trunk_base + th - 1;
                let leaf_top: i32 = trunk_top + 1;

                // trunk
                if (tx == wx && tz == wz && wy >= trunk_base && wy <= trunk_top) {
                    let tree_type: i64 = hash_2d(tx, tz, seed + 888888);
                    let ttp: i64 = hash_pos(tree_type);
                    if ((ttp & 7) < 4) { return BLK_OAK_LOG(); }
                    if ((ttp & 7) < 6) { return BLK_BIRCH_LOG(); }
                    return BLK_SPRUCE_LOG();
                }

                // leaves
                if (wy >= trunk_top - 1 && wy <= leaf_top) {
                    let dx: i32 = wx - tx;
                    let dz: i32 = wz - tz;
                    if (dx < 0) { dx = 0 - dx; }
                    if (dz < 0) { dz = 0 - dz; }

                    let max_r: i32 = 2;
                    if (wy >= trunk_top) { max_r = 1; }

                    if (dx <= max_r && dz <= max_r) {
                        if (!(tx == wx && tz == wz)) {
                            let existing: i32 = terrain_block_at_h(wx, wy, wz, seed, surface);
                            if (existing == BLK_AIR()) {
                                let tree_type: i64 = hash_2d(tx, tz, seed + 888888);
                                let ttp: i64 = hash_pos(tree_type);
                                if ((ttp & 7) < 4) { return BLK_OAK_LEAVES(); }
                                if ((ttp & 7) < 6) { return BLK_BIRCH_LEAVES(); }
                                return BLK_SPRUCE_LEAVES();
                            }
                        }
                    }
                }
            }
            tz = tz + 1;
        }
        tx = tx + 1;
    }

    // vegetation on grass blocks (one block above surface)
    if (wy == surface + 1 && surface > SEA_LEVEL() + 1 && surface < 120) {
        let base_block: i32 = terrain_block_at_h(wx, wy - 1, wz, seed, surface);
        if (base_block == BLK_GRASS_BLOCK()) {
            let veg_h: i64 = hash_2d(wx, wz, seed + 999999);
            let vegp: i64 = hash_pos(veg_h);
            if ((vegp % 7) == 0) { return BLK_SHORT_GRASS(); }
            if ((vegp % 50) == 1) { return BLK_DANDELION(); }
            if ((vegp % 50) == 2) { return BLK_POPPY(); }
        }
    }

    // default terrain generation
    return terrain_block_at_h(wx, wy, wz, seed, surface);
}

fn terrain_block_with_trees(wx: i32, wy: i32, wz: i32, seed: i32) -> i32 {
    let surface: i32 = terrain_height(wx, wz, seed);
    return terrain_block_with_trees_h(wx, wy, wz, seed, surface);
}
