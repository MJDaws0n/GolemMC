// ---------------------------------------------------------------------------
// items.nov - complete MC 1.21.11 item registry
//
// auto-generated from minecraft-data for protocol 774
// 1505 total items w/ their numeric IDs
// ---------------------------------------------------------------------------

module items;

import blocks;

// reset the 36-slot inventory to empty (-1 = no item)
fn inv_reset(inv: str) -> void {
    let i: i32 = 0;
    while (i < 36) {
        inv[i] = 255;
        i = i + 1;
    }
}

// map an item id to the default block state when placed
// wraps blocks.item_to_block for the full mapping
fn item_to_block_state(item_id: i32) -> i32 {
    return item_to_block(item_id);
}

