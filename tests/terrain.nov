module terrain_tests;

import ../lib/std;
import ../lib/file_io;
import ../lib/digest;
import ../src/identity;
import ../src/terrain/overworld;
import ../src/terrain/chunk;

fn hex_hash(data: str, size: i32) -> str {
    let digest: str = digest_sha256(data, size);
    let alphabet: str = "0123456789abcdef";
    let encoded: str = alloc_string(64);
    for (let index: i32 = 0; index < 32; index++) {
        let byte: i32 = load8(ptr(digest) + to_u64(index));
        store8(ptr(encoded) + to_u64(index * 2), byte_at(alphabet, byte >> 4));
        store8(ptr(encoded) + to_u64(index * 2 + 1), byte_at(alphabet, byte & 15));
    }
    return encoded;
}

fn block_hash(chunk: TerrainChunk) -> str {
    let states: str = alloc_string(196608);
    for (let index: i32 = 0; index < 98304; index++) {
        let state: i32 = chunk.state(index);
        store8(ptr(states) + to_u64(index * 2), state >> 8);
        store8(ptr(states) + to_u64(index * 2 + 1), state & 255);
    }
    return hex_hash(states, 196608);
}

fn biome_hash(chunk: TerrainChunk) -> str {
    let biomes: str = alloc_string(1536);
    for (let index: i32 = 0; index < 1536; index++) { store8(ptr(biomes) + to_u64(index), chunk.biome(index)); }
    return hex_hash(biomes, 1536);
}

fn main() -> i32 {
    let fixtures: FileTextResult = read_all_text("tests/terrain-774.sha256");
    if (fixtures.error != "") { print(fixtures.error); return 1; }
    let rows: []str = string_split(fixtures.data, "\n");
    let generator: Overworld = null;
    let last_seed: i64 = 0;
    let checked: i32 = 0;
    for (let index: i32 = 0; index < len(rows); index++) {
        let row: str = rows[index];
        if (row == "" || starts_with(row, "#")) { continue; }
        let fields: []str = string_split(row, " ");
        if (len(fields) != 7) { return 1; }
        let seed: i64 = to_i64(fields[0]);
        let x: i32 = to_i32(fields[1]); let z: i32 = to_i32(fields[2]);
        if (generator == null || seed != last_seed) {
            generator = new Overworld(seed, hash_seed(seed));
            if (!generator.ready) { print("Could not load Overworld data"); return 1; }
            last_seed = seed;
        }
        let base: TerrainChunk = generator.base_chunk(x, z);
        let surface: TerrainChunk = generator.surface_chunk(x, z);
        let carved: TerrainChunk = generator.chunk(x, z);
        let actual: []str = [block_hash(base), block_hash(surface), block_hash(carved), biome_hash(carved)];
        let stages: []str = ["base terrain", "surface", "carvers", "biomes"];
        for (let stage: i32 = 0; stage < len(stages); stage++) {
            if (actual[stage] != fields[stage + 3]) {
                print("Seed " + fields[0] + ", chunk " + fields[1] + "," + fields[2] + ": " + stages[stage] +
                    "\nExpected " + fields[stage + 3] + "\nActual   " + actual[stage]);
                return 1;
            }
        }
        checked++;
    }
    print("Matched Minecraft at the noise, surface, carver and biome stages in " + to_str(checked) + " chunks");
    if (checked != 25) { return 1; }
    return 0;
}
