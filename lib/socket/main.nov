module socket;

import ../std;
import ../darwin;

fn socket_shutdown_write(fd: i32) -> void { darwin_syscall(134, to_u64(fd), 1); }
fn socket_close(fd: i32) -> void { darwin_syscall(6, to_u64(fd)); }

fn ipv4_endpoint(address: str, port: i32) -> str {
    if (port < 0 || port > 65535) { return ""; }
    let endpoint: str = alloc_string(16);
    memset(ptr(endpoint), 0, 16);
    string_set_byte(endpoint, 0, 16);
    string_set_byte(endpoint, 1, 2); // AF_INET
    string_set_byte(endpoint, 2, port >> 8);
    string_set_byte(endpoint, 3, port);
    let offset: i32 = 0;
    for (let index: i32 = 0; index < 4; index++) {
        let value: i32 = 0;
        let digits: i32 = 0;
        while (offset < len(address) && byte_at(address, offset) != 46) {
            let digit: i32 = byte_at(address, offset) - 48;
            if (digit < 0 || digit > 9 || digits == 3) { return ""; }
            value = value * 10 + digit;
            offset++;
            digits++;
        }
        if (digits == 0 || value > 255) { return ""; }
        string_set_byte(endpoint, 4 + index, value);
        if (index < 3) {
            if (offset == len(address)) { return ""; }
            offset++;
        }
    }
    if (offset != len(address)) { return ""; }
    return endpoint;
}

fn socket_option(fd: i32, level: i32, name: i32) -> bool {
    let one: i32 = 1;
    let address: u64 = &one;
    return darwin_syscall(105, to_u64(fd), to_u64(level), to_u64(name), address, 4) == 0;
}

fn socket_listener(address: str, port: i32) -> i32 {
    let endpoint: str = ipv4_endpoint(address, port);
    if (endpoint == "") { return -1; }
    let fd: i32 = darwin_syscall(97, 2, 1); // socket(AF_INET, SOCK_STREAM)
    if (fd < 0) { return -1; }
    if (!socket_option(fd, 65535, 4) ||
        darwin_syscall(104, to_u64(fd), ptr(endpoint), 16) < 0 ||
        darwin_syscall(106, to_u64(fd), 32) < 0) {
        socket_close(fd);
        return -1;
    }
    return fd;
}

fn socket_accept(fd: i32) -> i32 {
    let client: i32 = darwin_syscall(30, to_u64(fd)); // accept
    if (client < 0) { return -1; }
    if (!socket_option(client, 65535, 0x1022)) { // SOL_SOCKET, SO_NOSIGPIPE
        socket_close(client);
        return -1;
    }
    socket_option(client, 6, 1); // IPPROTO_TCP, TCP_NODELAY
    return client;
}

fn socket_io_result(result: i32) -> i32 {
    if (result == -35 || result == -4) { return -2; } // EAGAIN or EINTR
    if (result < 0) { return -1; }
    return result;
}

fn socket_read(fd: i32, address: u64, amount: i32) -> i32 {
    return socket_io_result(darwin_syscall(29, to_u64(fd), address, to_u64(amount), 0x80)); // recvfrom, MSG_DONTWAIT
}

fn socket_write(fd: i32, address: u64, amount: i32) -> i32 {
    return socket_io_result(darwin_syscall(133, to_u64(fd), address, to_u64(amount), 0x80)); // sendto, MSG_DONTWAIT
}

class PollSet {
    let data: str;
    let size: i32 = 0;
    let capacity: i32;

    pub init(capacity: i32) {
        self.capacity = capacity;
        self.data = alloc_string(capacity * 8);
    }

    pub fn clear() -> void { self.size = 0; }

    pub fn add(fd: i32, events: i32) -> void {
        if (self.size >= self.capacity) { return; }
        let address: u64 = ptr(self.data) + to_u64(self.size * 8);
        store32(address, fd);
        store32(address + 4, events & 65535);
        self.size++;
    }

    pub fn wait(timeout: i32) -> i32 {
        return darwin_syscall(230, ptr(self.data), to_u64(self.size), to_u64(timeout)); // poll
    }

    pub fn events(index: i32) -> i32 {
        return byte_at(self.data, index * 8 + 6) | (byte_at(self.data, index * 8 + 7) << 8);
    }
}
