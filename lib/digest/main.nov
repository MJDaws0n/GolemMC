module digest;

import ../std;

fn rotate_left32(value: u64, count: u64) -> u64 {
    return ((value << count) | (value >> (32 - count))) & 4294967295;
}

fn rotate_right32(value: u64, count: u64) -> u64 {
    return rotate_left32(value, 32 - count);
}

// RFC 1321. Explicit lengths permit binary messages containing NUL bytes.
fn digest_md5(input_bytes: str, length: i32) -> str {
    let padded: i32 = ((length + 8) / 64 + 1) * 64;
    let message: str = alloc_string(padded);
    memset(ptr(message), 0, padded);
    memory_copy(ptr(message), ptr(input_bytes), length);
    string_set_byte(message, length, 128);
    store64(ptr(message) + to_u64(padded - 8), to_u64(length) * 8);
    let constants: []u64 = [
        0xd76aa478, 0xe8c7b756, 0x242070db, 0xc1bdceee, 0xf57c0faf, 0x4787c62a, 0xa8304613, 0xfd469501,
        0x698098d8, 0x8b44f7af, 0xffff5bb1, 0x895cd7be, 0x6b901122, 0xfd987193, 0xa679438e, 0x49b40821,
        0xf61e2562, 0xc040b340, 0x265e5a51, 0xe9b6c7aa, 0xd62f105d, 0x02441453, 0xd8a1e681, 0xe7d3fbc8,
        0x21e1cde6, 0xc33707d6, 0xf4d50d87, 0x455a14ed, 0xa9e3e905, 0xfcefa3f8, 0x676f02d9, 0x8d2a4c8a,
        0xfffa3942, 0x8771f681, 0x6d9d6122, 0xfde5380c, 0xa4beea44, 0x4bdecfa9, 0xf6bb4b60, 0xbebfbc70,
        0x289b7ec6, 0xeaa127fa, 0xd4ef3085, 0x04881d05, 0xd9d4d039, 0xe6db99e5, 0x1fa27cf8, 0xc4ac5665,
        0xf4292244, 0x432aff97, 0xab9423a7, 0xfc93a039, 0x655b59c3, 0x8f0ccc92, 0xffeff47d, 0x85845dd1,
        0x6fa87e4f, 0xfe2ce6e0, 0xa3014314, 0x4e0811a1, 0xf7537e82, 0xbd3af235, 0x2ad7d2bb, 0xeb86d391
    ];
    let shifts: []u64 = [7, 12, 17, 22, 5, 9, 14, 20, 4, 11, 16, 23, 6, 10, 15, 21];
    let ha: u64 = 0x67452301;
    let hb: u64 = 0xefcdab89;
    let hc: u64 = 0x98badcfe;
    let hd: u64 = 0x10325476;
    for (let offset: i32 = 0; offset < padded; offset += 64) {
        let a: u64 = ha; let b: u64 = hb; let c: u64 = hc; let d: u64 = hd;
        for (let round: i32 = 0; round < 64; round++) {
            let f: u64 = 0;
            let word: i32 = round;
            if (round < 16) { f = (b & c) | (~b & d); }
            else if (round < 32) { f = (d & b) | (~d & c); word = (5 * round + 1) & 15; }
            else if (round < 48) { f = b ^ c ^ d; word = (3 * round + 5) & 15; }
            else { f = c ^ (b | ~d); word = (7 * round) & 15; }
            let data_word: u64 = to_u64(load32(ptr(message) + to_u64(offset + word * 4))) & 4294967295;
            let mixed: u64 = (a + f + constants[round] + data_word) & 4294967295;
            a = d; d = c; c = b;
            b = (b + rotate_left32(mixed, shifts[(round / 16) * 4 + (round & 3)])) & 4294967295;
        }
        ha = (ha + a) & 4294967295; hb = (hb + b) & 4294967295;
        hc = (hc + c) & 4294967295; hd = (hd + d) & 4294967295;
    }
    let result: str = alloc_string(16);
    store32(ptr(result), to_i32(ha)); store32(ptr(result) + 4, to_i32(hb));
    store32(ptr(result) + 8, to_i32(hc)); store32(ptr(result) + 12, to_i32(hd));
    return result;
}

// FIPS 180-4 SHA-256.
fn digest_sha256(input_bytes: str, length: i32) -> str {
    let padded: i32 = ((length + 8) / 64 + 1) * 64;
    let message: str = alloc_string(padded);
    memset(ptr(message), 0, padded);
    memory_copy(ptr(message), ptr(input_bytes), length);
    string_set_byte(message, length, 128);
    let bits: u64 = to_u64(length) * 8;
    for (let index: i32 = 0; index < 8; index++) {
        string_set_byte(message, padded - 1 - index, to_i32(bits >> to_u64(index * 8)));
    }
    let constants: []u64 = [
        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
        0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
    ];
    let hash: []u64 = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19];
    for (let offset: i32 = 0; offset < padded; offset += 64) {
        let words: []u64 = [];
        for (let word: i32 = 0; word < 16; word++) {
            let value: u64 = 0;
            for (let index: i32 = 0; index < 4; index++) {
                value = (value << 8) | to_u64(byte_at(message, offset + 4 * word + index));
            }
            array_append(words, value);
        }
        for (let word: i32 = 16; word < 64; word++) {
            let low: u64 = words[word - 15];
            let high: u64 = words[word - 2];
            let s0: u64 = rotate_right32(low, 7) ^ rotate_right32(low, 18) ^ (low >> 3);
            let s1: u64 = rotate_right32(high, 17) ^ rotate_right32(high, 19) ^ (high >> 10);
            array_append(words, (words[word - 16] + s0 + words[word - 7] + s1) & 4294967295);
        }
        let a: u64 = hash[0]; let b: u64 = hash[1]; let c: u64 = hash[2]; let d: u64 = hash[3];
        let e: u64 = hash[4]; let f: u64 = hash[5]; let g: u64 = hash[6]; let h: u64 = hash[7];
        for (let round: i32 = 0; round < 64; round++) {
            let choice: u64 = (e & f) ^ (~e & g);
            let majority: u64 = (a & b) ^ (a & c) ^ (b & c);
            let sum_e: u64 = rotate_right32(e, 6) ^ rotate_right32(e, 11) ^ rotate_right32(e, 25);
            let sum_a: u64 = rotate_right32(a, 2) ^ rotate_right32(a, 13) ^ rotate_right32(a, 22);
            let t1: u64 = h + sum_e + choice + constants[round] + words[round];
            h = g; g = f; f = e; e = (d + t1) & 4294967295;
            d = c; c = b; b = a; a = (t1 + sum_a + majority) & 4294967295;
        }
        let state: []u64 = [a, b, c, d, e, f, g, h];
        for (let index: i32 = 0; index < 8; index++) { hash[index] = (hash[index] + state[index]) & 4294967295; }
    }
    let result: str = alloc_string(32);
    for (let word: i32 = 0; word < 8; word++) {
        for (let index: i32 = 0; index < 4; index++) {
            string_set_byte(result, word * 4 + index, to_i32(hash[word] >> to_u64((3 - index) * 8)));
        }
    }
    return result;
}
